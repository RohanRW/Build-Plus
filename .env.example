# Google Sheets — landowner enquiry destination
# 1. Create a service account in Google Cloud and enable the Sheets API.
# 2. Share the spreadsheet with the service account email (Editor).
# 3. Copy this file to .env.local and fill in the values.

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Enquiries
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full key including the BEGIN/END lines, with \n for newlines,
# wrapped in double quotes.
GOOGLE_PRIVATE_KEY=""

# Public site URL, used for canonical tags, sitemap.xml and Open Graph.
NEXT_PUBLIC_SITE_URL=
